# ==== Segredos e credenciais (nunca versionar) ====
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json

# ==== Dependências / árvores pesadas ====
node_modules/
nanodesk/nm-prod/

# ==== Builds e artefatos gerados (não versionar) ====
nanodesk/NanoDesk-win32-x64/
nanodesk/staging/
nanodesk/tk
nanodesk/*.asar
nanodesk/*.asar.new
nanodesk/*.asar.new.unpacked/
nanodesk/*.asar.unpacked/
nanodesk/app-src/release/

# ==== Área de testes/auditoria interna (pedido: não publicar) ====
nanodesk/app-src/tests/
AUDITORIA-*
TESTE-MANUAL-*
RELATORIO-DE-CORRECOES-*

# ==== Sandbox / arquivos de trabalho (não fazem parte do projeto) ====
upload/
download/
.dtest/
skills/
scripts/

# ==== Logs e temporários ====
*.log
*.tmp
.DS_Store
Thumbs.db

# ==== CI workflow (NÃO versionar enquanto o token não tiver permissão 'workflow') ====
# O GitHub rejeita QUALQUER push que crie/atualize arquivos em
# .github/workflows/ sem a permissão 'workflow' no token — e commits
# automáticos com este arquivo travam todo o push do repositório.
# O arquivo fica em disco e em download/supply-chain.yml; para publicar,
# dê a permissão 'workflows' ao token e use `git add -f` ou remova esta linha.
.github/workflows/supply-chain.yml
